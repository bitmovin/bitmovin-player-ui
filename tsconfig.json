{
  "files": ["src/ts/main.ts"],
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "es5",
    "declaration": true,
    "outDir": "dist/js/framework",
    "lib": ["ES2016.Array.Include", "dom", "scripthost"],
    "skipLibCheck": true,
    // To be able to import Json Files.
    "resolveJsonModule": true,
    "esModuleInterop": false
  }
}
