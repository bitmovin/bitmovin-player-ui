{
  "name": "bitmovin-player-ui",
  "version": "4.0.0-alpha.1",
  "description": "Bitmovin Player UI Framework",
  "main": "./dist/js/bitmovinplayer-ui.js",
  "types": "./dist/js/framework/main.d.ts",
  "scripts": {
    "test": "npx jest",
    "build": "npx webpack --mode development",
    "build:prod": "npm run lint && npm run clean && npx webpack --mode production && npm run copy-json",
    "lint": "npm run lint-ts && npm run lint-sass",
    "format": "npx prettier --write *",
    "docs": "npx typedoc",
    "clean": "rm -r dist",
    "copy-json": "mkdir -p dist/js/framework && cp src/ts/localization/languages/*.json dist/js/framework/",
    "lint-ts": "npx eslint 'src/ts/**/*.ts'",
    "lint-sass": "npx sass-lint",
    "prepublishOnly": "npm run build:prod && npm run copy-json",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitmovin/bitmovin-player-ui.git"
  },
  "author": "Bitmovin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bitmovin/bitmovin-player-ui/issues"
  },
  "homepage": "https://github.com/bitmovin/bitmovin-player-ui#readme",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR"
  ],
  "lint-staged": {
    "(src/**/*.ts)": [
      "eslint --fix"
    ],
    "(*.ts|*.json|*.js|*.mjs|*.html|*.md|*.scss|*.prettierignore)": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@inrupt/jest-jsdom-polyfills": "^1.6.0",
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^21.1.0",
    "autoprefixer": "^10.4.14",
    "bitmovin-player": "^8.129.0",
    "browser-sync": "^2.29.0",
    "browserify": "^17.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^5.1.15",
    "del": "^2.2.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "gulp": "^4.0.2",
    "gulp-css-base64": "^2.0.0",
    "gulp-eslint-new": "^2.5.0",
    "gulp-header": "^2.0.9",
    "gulp-postcss": "^9.0.1",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^5.1.0",
    "gulp-sass-lint": "^1.4.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-typescript": "^5.0.1",
    "gulp-uglify": "^3.0.2",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^15.3.0",
    "merge2": "^1.4.1",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-svg": "^3.0.0",
    "prettier": "^3.6.2",
    "sass": "^1.59.3",
    "sass-loader": "^16.0.5",
    "semver": "^7.5.4",
    "stream-combiner2": "^1.1.1",
    "string-replace-loader": "^3.2.0",
    "ts-jest": "^29.0.5",
    "ts-loader": "^9.5.4",
    "tsify": "^5.0.4",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0",
    "watchify": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "yargs": "^17.7.1"
  }
}
